# ============================================================================
# CourtZon Environment Variables (Example)
# Copy to .env and fill in your values. NEVER commit real secrets.
# ============================================================================

# ── Database ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=courtzon_v3
DB_USER=app_user
DB_PASSWORD=change-me

# ── Migration environment ──
# local      = Docker/local development. The full chain 001–162 is now
#              PRODUCTION_SAFE (Phase 0 / Group 3). FUTURE LOCAL_DOCKER_ONLY
#              migrations run only when this is 'local'.
# production = Hostinger/production (set explicitly in the Coolify UI).
# unset      = treated as UNKNOWN and FAIL-CLOSED: LOCAL_DOCKER_ONLY migrations
#              are skipped and never recorded.
# Enforced by backend/scripts/migration-guard.sh in BOTH the Docker entrypoint
# and scripts/migrate.sh.
COURTZON_MIGRATION_ENV=local

# Skip every startup database write (migrations, role-permission sync,
# translation-registry sync, notification-template seeding).
# 0 = standard behaviour (default, required in production).
# 1 = verification only — the backend starts without writing to the database.
COURTZON_SKIP_STARTUP_DB_SYNC=0

# ── Docker MySQL (if using Docker database) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Host port when using Docker MySQL (avoids conflict with local MySQL on 3306)
MYSQL_PUBLISH_PORT=3307
MYSQL_DATABASE=courtzon_v3
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── App ──
PORT=3000
FRONTEND_PORT=5173
NODE_ENV=development
APP_URL=http://localhost:5173

# ── Docker / observability (local stack) ──
# ENABLE_API_DOCS=true   # Swagger at /docs (omit in real production)
# METRICS_TOKEN=         # Optional Bearer token for GET /metrics (Prometheus scrape)
# GRAFANA_PASSWORD=admin # docker-compose.monitoring.yml

# ── Email (optional — defaults to log-only) ──
# MAIL_TRANSPORT=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USER=your@email.com
# MAIL_PASS=your-password
# MAIL_FROM=noreply@courtzon.com

# ── Notifications: SMS & Push providers ──
# SMS channel (both are OPTIONAL). If neither TWILIO_ACCOUNT_SID nor
# VONAGE_API_KEY is set, isAvailable() returns false and SMS delivery is
# skipped. IMPORTANT: these providers currently return a mock success in code
# (no real Twilio/Vonage HTTP call yet); a real provider integration is
# required before relying on SMS delivery in production.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_FROM=

# Push channel (FCM for Android/web, APNs for iOS). Push is available by
# default but sendFCM/sendAPNs currently return a mock success (no real
# Firebase/APNs call yet). Real provider integration is required before
# relying on push delivery in production.
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_APP_BUNDLE_ID=
# APNS_PRIVATE_KEY=

# ── Storage ──
# STORAGE_PROVIDER=local     # local | s3 | r2
# S3_ENDPOINT=https://...
# S3_BUCKET=courtzon-uploads
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=auto

# ── Paymob ──
# PAYMENT_GATEWAY_PROVIDER=mock | paymob
# PAYMOB_API_KEY=ZXlK...                          # Accept API key (for refunds)
# PAYMOB_SECRET=sk_...                             # Secret key (Intention API auth)
# PAYMOB_PUBLIC_KEY=pk_...                         # Public key (Unified Checkout URL)
# PAYMOB_MERCHANT_ID=5663993                       # Integration ID
# PAYMOB_HMAC_SECRET=...                           # Webhook HMAC secret
# PAYMOB_SANDBOX=true                              # true = test mode
# REQUIRED in production when PAYMENT_GATEWAY_PROVIDER=paymob: leaving it unset
# (or empty) refuses startup because the schema no longer defaults it.

# ── Security ──
# SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
# JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# CORS_ORIGINS=https://courtzon.com,https://admin.courtzon.com
# AUTH_TEMPORARY_RESET_ENABLED=false
#   Temporary password reset (email-only, no OTP) is DISABLED by default and
#   requires BOTH this env flag = 'true' AND the DB feature flag
#   auth.temporary_password_reset_enabled. NEVER enable in production; leave
#   unset or 'false'. See backend/src/config/env.ts and auth.routes.ts.
# RELAX_RATE_LIMIT=false
#   Local Docker development ONLY: set RELAX_RATE_LIMIT=true to relax the rate
#   limiter (2000/min), allow any CORS origin, skip the HTTPS redirect, and send
#   non-Secure session cookies. NEVER set this in production — the production
#   compose default is false (Secure cookies, closed CORS, 100 req/min, HTTPS
#   redirect), so production security is NOT relaxed unless explicitly opted in.

# ============================================================================
# Production-Only Variables
# ============================================================================

# ── Production URLs (used for CORS, redirects, webhooks) ──
# FRONTEND_URL=https://www.courtzon.cloud
# APP_URL=https://api.courtzon.cloud

# ── Production logging ──
# LOG_LEVEL=info

# ── Backup pipeline (encrypted database backups) ──
# The backup job writes AES-256-GCM artifacts (*.sql.gz.enc2) plus a
# *.sha256 sidecar. BACKUP_ENCRYPTION_KEY is ALWAYS required; in production
# the DB_BACKUP_USER + DB_BACKUP_PASSWORD pair is additionally required.
# These are not alternative choices: the job fails closed when any required
# value is missing.
#
# Container path where artifacts are written. In Docker this is the
# backend_backups named volume; docker-entrypoint.sh sets it to
# appuser:appgroup (mode 750) before dropping privileges.
# BACKUP_DIR=/app/backups
#
# Exactly 64 hex characters (32 bytes). ESCROW THIS KEY OUTSIDE THE SERVER:
# losing it makes every .enc2 backup unrecoverable. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY=
#
# Only "gcm" is supported and it is the default; any other value fails closed.
# BACKUP_ENCRYPTION_FORMAT=gcm
#
# Dedicated dump credential. BOTH must be set together, and production requires
# them: the application DB_USER/DB_PASSWORD are never used as a fallback.
# DB_BACKUP_USER=courtzon_backup
# DB_BACKUP_PASSWORD=
#
# Retention: keep the newest N GCM backups (newest is always preserved) and
# optionally spare anything younger than D days (0 = age rule disabled).
# BACKUP_RETENTION_COUNT=30
# BACKUP_RETENTION_DAYS=0
#
# Streaming size ceiling in bytes (default 64 GiB = 68719476736).
# BACKUP_MAX_BYTES=68719476736
#
# Offsite upload (optional). S3_* names are shared with the Storage section
# above. All four of S3_BUCKET/S3_ACCESS_KEY/S3_SECRET_KEY/S3_ENDPOINT must be
# set or none: a partial configuration fails the job. S3_REQUIRED=1 turns a
# skipped or failed upload into a job failure.
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_REQUIRED=0

# ============================================================================
# Database TLS policy
# ============================================================================
# One policy for every connection path: the application pool, the migration
# runner (scripts/migrate.sh / backend/scripts/migrate.js) and the mariadb CLI.
# Full matrix and limitations: docs/database-tls-policy.md
#
#   disable    Plaintext. Compatibility default ONLY for local development
#              (COURTZON_MIGRATION_ENV=local, or NODE_ENV=development|test).
#   require    Encrypted, but the server certificate is NOT verified — no
#              protection against a man-in-the-middle.
#   verify-ca  Encrypted + certificate chain and hostname verification using
#              DB_TLS_CA_PATH. Requires a server certificate whose SAN matches
#              the host used to connect (the MySQL auto-generated certificate
#              does not, so this mode cannot work against it).
#
# Non-local environments MUST set DB_TLS_MODE explicitly; startup fails closed
# otherwise — plaintext is never an implicit production default.
# DB_TLS_MODE=disable
# DB_TLS_CA_PATH=/certs/mysql-ca.pem
